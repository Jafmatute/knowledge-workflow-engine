{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "paths": {},
    "rootDir": "src",
    "sourceMap": true
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__fixtures__/**",
    "src/**/test-helpers/**"
  ]
}
